---
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  twitterCard?: "summary" | "summary_large_image";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title,
  description,
  canonical,
  ogImage = "/favicon.svg",
  ogType = "website",
  twitterCard = "summary_large_image",
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL("https://www.beautylineprofessional.com");
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="twitter:card" content={twitterCard} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <title>{title}</title>
    <script is:inline>
      (function () {
        var CONSENT_KEYS = [
          "ad_storage",
          "analytics_storage",
          "ad_user_data",
          "ad_personalization",
          "personalization_storage",
          "functionality_storage",
          "security_storage",
        ];
        var CONSENT_COOKIE = "cookie_consent";
        var LEGACY_STORAGE_KEY = "cookieConsentChoice";
        var CONSENT_MAX_AGE = 60 * 60 * 24 * 180;

        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;

        function cookieOptions(maxAge) {
          var parts = ["Path=/", "Max-Age=" + maxAge, "SameSite=Lax"];
          if (location.protocol === "https:") parts.push("Secure");
          return parts.join("; ");
        }

        function writeCookie(name, value) {
          document.cookie =
            name + "=" + encodeURIComponent(value) + "; " + cookieOptions(CONSENT_MAX_AGE);
        }

        function deleteCookie(name) {
          document.cookie = name + "=; " + cookieOptions(0);
        }

        function readCookie(name) {
          var prefix = name + "=";
          var cookies = document.cookie.split(";");
          for (var i = 0; i < cookies.length; i++) {
            var part = cookies[i].trim();
            if (part.indexOf(prefix) === 0) {
              return decodeURIComponent(part.slice(prefix.length));
            }
          }
          return "";
        }

        function grantedState() {
          return {
            ad_storage: "granted",
            analytics_storage: "granted",
            ad_user_data: "granted",
            ad_personalization: "granted",
            personalization_storage: "granted",
            functionality_storage: "granted",
            security_storage: "granted",
          };
        }

        function essentialState() {
          return {
            ad_storage: "denied",
            analytics_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            personalization_storage: "denied",
            functionality_storage: "granted",
            security_storage: "granted",
          };
        }

        function deniedState() {
          return {
            ad_storage: "denied",
            analytics_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            personalization_storage: "denied",
            functionality_storage: "denied",
            security_storage: "granted",
          };
        }

        function isConsentValue(value) {
          return value === "granted" || value === "denied";
        }

        function persistConsent(state) {
          writeCookie(CONSENT_COOKIE, JSON.stringify(state));
          for (var i = 0; i < CONSENT_KEYS.length; i++) {
            writeCookie(CONSENT_KEYS[i], state[CONSENT_KEYS[i]]);
          }
          try {
            localStorage.setItem(
              LEGACY_STORAGE_KEY,
              state.ad_storage === "granted" ? "accepted_all" : "essential_only"
            );
          } catch (error) {
            // localStorage can be unavailable; first-party cookies remain the source of truth.
          }
        }

        function getStoredConsent() {
          try {
            var parsed = JSON.parse(readCookie(CONSENT_COOKIE) || "");
            if (parsed && isConsentValue(parsed.ad_storage)) return parsed;
          } catch (error) {
            // Fall through to individual cookies or legacy storage.
          }

          var fromCookies = {};
          var found = 0;
          for (var i = 0; i < CONSENT_KEYS.length; i++) {
            var value = readCookie(CONSENT_KEYS[i]);
            if (isConsentValue(value)) {
              fromCookies[CONSENT_KEYS[i]] = value;
              found += 1;
            }
          }
          if (found === CONSENT_KEYS.length) return fromCookies;

          try {
            var legacy = localStorage.getItem(LEGACY_STORAGE_KEY);
            if (legacy === "accepted_all") return grantedState();
            if (legacy === "essential_only") return essentialState();
          } catch (error) {
            // Ignore unavailable storage.
          }

          return null;
        }

        function applyConsent(state) {
          gtag("consent", "update", state);
          window.dataLayer.push({
            event: "cookie_consent_update",
            cookie_consent: state,
          });
        }

        gtag("consent", "default", Object.assign({ wait_for_update: 500 }, deniedState()));
        gtag("set", "ads_data_redaction", true);
        gtag("set", "url_passthrough", true);

        var storedConsent = getStoredConsent();
        if (storedConsent) {
          gtag("consent", "update", storedConsent);
          if (!readCookie(CONSENT_COOKIE)) {
            persistConsent(storedConsent);
          }
        }

        window.__cookieConsent = {
          hasChoice: function () {
            return !!getStoredConsent();
          },
          isAdvertisingGranted: function () {
            var state = getStoredConsent();
            return !!(state && state.ad_storage === "granted");
          },
          acceptAll: function () {
            var state = grantedState();
            persistConsent(state);
            applyConsent(state);
          },
          essentialOnly: function () {
            var state = essentialState();
            persistConsent(state);
            applyConsent(state);
          },
          reset: function () {
            deleteCookie(CONSENT_COOKIE);
            for (var i = 0; i < CONSENT_KEYS.length; i++) {
              deleteCookie(CONSENT_KEYS[i]);
            }
            try {
              localStorage.removeItem(LEGACY_STORAGE_KEY);
            } catch (error) {
              // Ignore unavailable storage.
            }
            applyConsent(deniedState());
          },
        };
      })();
    </script>
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0];
        var j = d.createElement(s);
        var dl = l !== "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-NFMBX8VX");
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NFMBX8VX"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
    <a
      href="https://wa.me/393382535226"
      class="whatsapp-float-button"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contattaci su WhatsApp"
      data-whatsapp-float
    >
      <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M16 5C9.925 5 5 9.925 5 16c0 2.111.598 4.169 1.73 5.943L5 27l5.23-1.692A10.95 10.95 0 0 0 16 27c6.075 0 11-4.925 11-11S22.075 5 16 5zm0 19.75c-1.76 0-3.481-.474-4.983-1.373l-.356-.213-3.102 1.004 1.012-3.032-.232-.368A8.7 8.7 0 0 1 7.25 16c0-4.832 3.918-8.75 8.75-8.75s8.75 3.918 8.75 8.75-3.918 8.75-8.75 8.75zm4.802-6.578c-.262-.131-1.552-.765-1.794-.853-.243-.09-.42-.131-.598.131-.176.262-.685.853-.839 1.029-.154.176-.307.197-.568.066-.262-.131-1.105-.408-2.105-1.302-.777-.694-1.301-1.551-1.454-1.813-.154-.262-.016-.403.115-.534.117-.116.262-.307.393-.461.131-.154.176-.262.262-.438.088-.176.044-.328-.022-.46-.066-.131-.597-1.441-.818-1.976-.215-.517-.433-.447-.598-.455l-.51-.009c-.176 0-.461.066-.701.328-.243.262-.922.901-.922 2.195 0 1.293.944 2.543 1.076 2.719.131.176 1.855 2.833 4.493 3.973.628.271 1.118.433 1.5.555.63.2 1.204.172 1.657.105.506-.075 1.552-.634 1.771-1.248.218-.613.218-1.138.153-1.248-.066-.11-.242-.176-.504-.307z"
        />
      </svg>
    </a>
    <aside
      class="cookie-consent-banner"
      data-cookie-banner
      role="region"
      aria-label="Preferenze cookie"
      hidden
    >
      <p>
        Utilizziamo cookie tecnici necessari e, previo tuo consenso, cookie di analisi e pubblicitari tramite
        Google Tag Manager e Google Ads per misurare campagne, conversioni e proporti contenuti più pertinenti.
      </p>
      <div class="cookie-consent-actions">
        <button class="btn btn-primary" type="button" data-cookie-accept-all>
          Accetta tutti
        </button>
        <button class="btn btn-secondary" type="button" data-cookie-essential-only>
          Solo essenziali
        </button>
        <a href="/cookie-policy" class="cookie-consent-link">Maggiori dettagli</a>
      </div>
    </aside>
    <script>
      const GOOGLE_ADS_MEASUREMENT_ID = "AW-18143736615";
      const GOOGLE_ADS_CONVERSION_ID = "AW-18143736615/BE-VCJyNlKkcEKfmzctD";

      const consentBanner = document.querySelector("[data-cookie-banner]");
      const acceptAllButton = document.querySelector("[data-cookie-accept-all]");
      const essentialOnlyButton = document.querySelector("[data-cookie-essential-only]");
      const resetConsentButton = document.querySelector("[data-cookie-reset]");
      const whatsappFloatButton = document.querySelector("[data-whatsapp-float]");

      let trackingInitialized = false;

      type ConsentApi = {
        hasChoice: () => boolean;
        isAdvertisingGranted: () => boolean;
        acceptAll: () => void;
        essentialOnly: () => void;
        reset: () => void;
      };

      type TrackingWindow = Window & {
        dataLayer: unknown[];
        gtag?: (...args: unknown[]) => void;
        trackGoogleAdsConversion?: () => void;
        __cookieConsent?: ConsentApi;
      };

      const trackingWindow = window as unknown as TrackingWindow;
      const cookieConsent = trackingWindow.__cookieConsent;

      const hideBanner = () => {
        if (consentBanner instanceof HTMLElement) {
          consentBanner.setAttribute("hidden", "");
        }
      };

      const showBanner = () => {
        if (consentBanner instanceof HTMLElement) {
          consentBanner.removeAttribute("hidden");
        }
      };

      const initializeTrackingScripts = () => {
        if (trackingInitialized || !cookieConsent?.isAdvertisingGranted()) return;
        trackingInitialized = true;

        trackingWindow.dataLayer = trackingWindow.dataLayer ?? [];
        trackingWindow.gtag =
          trackingWindow.gtag ??
          function gtag() {
            trackingWindow.dataLayer.push(arguments as unknown as IArguments);
          };
        trackingWindow.gtag("js", new Date());
        trackingWindow.gtag("config", GOOGLE_ADS_MEASUREMENT_ID);

        const script = document.createElement("script");
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ADS_MEASUREMENT_ID}`;
        document.head.appendChild(script);
      };

      trackingWindow.trackGoogleAdsConversion = () => {
        if (!cookieConsent?.isAdvertisingGranted() || typeof trackingWindow.gtag !== "function") return;

        try {
          trackingWindow.gtag("event", "conversion", {
            send_to: GOOGLE_ADS_CONVERSION_ID,
          });
        } catch {
          // Never block primary UX for analytics failures.
        }
      };

      if (cookieConsent?.isAdvertisingGranted()) {
        initializeTrackingScripts();
        hideBanner();
      } else if (cookieConsent?.hasChoice()) {
        hideBanner();
      } else {
        showBanner();
      }

      if (acceptAllButton instanceof HTMLButtonElement) {
        acceptAllButton.addEventListener("click", () => {
          cookieConsent?.acceptAll();
          hideBanner();
          initializeTrackingScripts();
        });
      }

      if (essentialOnlyButton instanceof HTMLButtonElement) {
        essentialOnlyButton.addEventListener("click", () => {
          cookieConsent?.essentialOnly();
          hideBanner();
        });
      }

      if (resetConsentButton instanceof HTMLButtonElement) {
        resetConsentButton.addEventListener("click", () => {
          cookieConsent?.reset();
          trackingInitialized = false;
          showBanner();
        });
      }

      if (whatsappFloatButton instanceof HTMLAnchorElement) {
        whatsappFloatButton.addEventListener("click", () => {
          trackingWindow.trackGoogleAdsConversion?.();
        });
      }
    </script>
  </body>
</html>
