---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  defaultModalCarouselImages,
  pageContent,
  percorsi,
  programTracks,
  sectionAnchors,
} from "../data/percorsi";
import SiteFooter from "../components/SiteFooter.astro";

const heroCarouselImages = pageContent.hero.carouselImages;

const trackAnchors: Record<string, string> = {
  "Percorso Master Pro": "percorso-master-pro",
  "Percorso Master Experience": "percorso-master-experience",
};

const seoDescription =
  "Percorsi Master Beauty Line Academy: formazione nails con Master nazionali e internazionali a Monza. Solo 12 posti per percorso. Prenota con acconto di 299 EUR.";
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: pageContent.brand,
  url: pageContent.siteUrl,
  telephone: pageContent.contactPhone,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Via Michelangelo Buonarroti 24",
    addressLocality: "Monza",
    addressCountry: "IT",
  },
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pageContent.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
const homeJsonLd = [organizationSchema, faqSchema];
---

<BaseLayout title="Percorsi Master | Beauty Line Academy" description={seoDescription} jsonLd={homeJsonLd}>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand-logo-link" aria-label={pageContent.brand}>
        <img src="/images/logo-bl.png" alt={pageContent.brand} class="brand-logo brand-logo-header" />
      </a>
      <button
        class="nav-toggle"
        type="button"
        aria-label="Apri menu di navigazione"
        aria-controls="site-header-nav"
        aria-expanded="false"
        data-nav-toggle
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <nav class="header-nav" id="site-header-nav" data-header-nav data-open="false">
        <a href={`#${sectionAnchors.percorsi}`}>Percorsi</a>
        <a href={`#${sectionAnchors.requisiti}`}>Requisiti</a>
        <a href={`#${sectionAnchors.faq}`}>FAQ</a>
        <a href={`#${sectionAnchors.contatti}`}>Contatti</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div>
          <p class="eyebrow">{pageContent.hero.eyebrow}</p>
          <h1>{pageContent.hero.title}</h1>
          <p class="marked-text">{pageContent.hero.depositLine}</p>
          <p>{pageContent.hero.description}</p>
          <p class="marked-strong">{pageContent.hero.limitedSeats}</p>
          <div class="btn-row">
            <a class="btn btn-primary" href={`#${sectionAnchors.contatti}`}>{pageContent.hero.ctaPrimary}</a>
            <a class="btn btn-secondary" href={`#${sectionAnchors.percorsi}`}>{pageContent.hero.ctaSecondary}</a>
          </div>
        </div>
        <div
          class="hero-carousel"
          data-hero-carousel
          role="region"
          aria-label={pageContent.hero.imageAlt}
        >
          <div class="hero-carousel-viewport">
            <img
              src={heroCarouselImages[0]}
              alt=""
              class="hero-carousel-img"
              data-hero-carousel-img
              width="640"
              height="800"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <img
            src="/images/sponsor-1-no-bg.webp"
            alt="Sponsor"
            class="hero-carousel-sponsor"
            width="280"
            height="120"
            loading="eager"
            decoding="async"
          />
          <button
            type="button"
            class="hero-carousel-control hero-carousel-prev"
            data-hero-carousel-prev
            aria-label="Immagine precedente"
          >
            ‹
          </button>
          <button
            type="button"
            class="hero-carousel-control hero-carousel-next"
            data-hero-carousel-next
            aria-label="Immagine successiva"
          >
            ›
          </button>
          <div class="hero-carousel-dots" role="group" aria-label="Seleziona immagine">
            {heroCarouselImages.map((_, i) => (
              <button
                type="button"
                class:list={["hero-carousel-dot", i === 0 && "is-active"]}
                data-hero-carousel-dot={String(i)}
                aria-label={`Immagine ${i + 1} di ${heroCarouselImages.length}`}
                aria-current={i === 0 ? "true" : "false"}
              />
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <article class="card content-card">
          {pageContent.hero.introParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <p class="strong-black-line">{pageContent.hero.strongLine}</p>
          <p class="marked-text">{pageContent.hero.depositLine}</p>
        </article>
      </div>
    </section>

    <section class="section" id={sectionAnchors.percorsi}>
      <div class="container">
        <h2 class="section-title">{pageContent.comparisonTitle}</h2>
        <p class="section-subtitle">{pageContent.comparisonIntro}</p>
        <div class="grid two-col percorso-cards-grid" style="margin-top: 24px;">
          {percorsi.map((percorso) => (
            <a
              class="percorso-card-link"
              href={`#${trackAnchors[percorso.name] ?? sectionAnchors.programma}`}
              aria-label={`Vai a ${percorso.name}`}
            >
              <article class="card content-card percorso-summary-card">
                <p class="percorso-name">{percorso.shortName}</p>
                <div class="date-master-line date-master-head" role="presentation">
                  <span>Data</span>
                  <span>Master</span>
                  <span>Corso</span>
                </div>
                <ul class="date-master-list">
                  {programTracks
                    .find((track) => track.name === percorso.name)
                    ?.sessions.map((session) => (
                      <li class="date-master-line">
                        <span class="date-master-date">{session.date}</span>
                        <span class={`date-master-name ${session.isCeremony ? "date-master-name-ceremony" : ""}`}>
                          {session.master}
                        </span>
                        {!session.isCeremony && (
                          <span class="date-master-course">{session.lessonPlaceholder}</span>
                        )}
                      </li>
                    ))}
                </ul>
              </article>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id={sectionAnchors.programma}>
      <div class="container">
        {programTracks.map((track) => (
          <div style="margin-top: 26px;">
            <article id={trackAnchors[track.name]} class="card content-card">
              <p class="percorso-name percorso-name-program" style="margin-bottom: 0;">{track.name}</p>
              <p class="marked-text" style="text-align: center;">{track.description}</p>
              <p class="marked-text" style="text-align: center;">{track.description2}</p>
              {track.name === "Percorso Master Pro" && (
                <div style="margin-top: 16px;">
                  <p><strong>Crescita tecnica completa.</strong></p>
                  <p>
                    Percorso pensato per onicotecniche che desiderano vivere la loro prima esperienza
                    all&apos;interno di un vero percorso Master.
                  </p>
                  <p>
                    E&apos; aperto a tutte le professioniste che vogliono migliorare la propria tecnica, confrontarsi con
                    Master nazionali e internazionali e iniziare a entrare nel mondo della formazione di alto livello.
                  </p>
                  <p>
                    Durante il percorso le partecipanti lavoreranno passo dopo passo insieme ai Master,
                    sviluppando precisione, struttura e metodo di lavoro professionale.
                  </p>
                  <h4>Cosa include</h4>
                  <ul>
                    <li>6 giornate di formazione con Master nazionali e internazionali</li>
                    <li>Classi a numero chiuso (max 12 partecipanti)</li>
                    <li>6 attestati di partecipazione</li>
                    <li>Valutazione tecnica durante il percorso</li>
                    <li>Kit professionale in omaggio firmato CHRIS NAILS</li>
                    <li>Gadget e merchandising esclusivo</li>
                    <li>Confronto diretto con i Master durante le giornate di formazione</li>
                    <li>Preparazione tecnica per migliorare struttura, precisione e metodo di lavoro</li>
                    <li>Cerimonia finale con consegna ufficiale degli attestati - Master Award Day</li>
                  </ul>
                  <h4>Certificazione finale</h4>
                  <p>
                    Al termine del percorso le partecipanti riceveranno una certificazione finale basata sulla
                    valutazione tecnica ottenuta durante il percorso.
                  </p>
                  <p>In base al livello raggiunto verra assegnato uno dei seguenti attestati:</p>
                  <ul>
                    <li>Tecnico (Bronze)</li>
                    <li>Tecnico Expert (Silver)</li>
                    <li>Master (Gold)</li>
                  </ul>
                  <p>
                    Un riconoscimento professionale che valorizza il percorso svolto e il livello tecnico raggiunto.
                  </p>
                </div>
              )}
              {track.name === "Percorso Master Experience" && (
                <div style="margin-top: 16px;">
                  <p><strong>Formazione intensiva con Master internazionali e mondiali</strong></p>
                  <p>
                    Percorso dedicato a onicotecniche che hanno gia partecipato a campus, percorsi formativi, gare
                    o corsi avanzati e desiderano confrontarsi con Master internazionali e mondiali di altissimo
                    livello.
                  </p>
                  <p>
                    E&apos; pensato per professioniste che vogliono vivere una vera esperienza Master, lavorando
                    direttamente con grandi nomi del settore e portando la propria tecnica ad uno standard
                    superiore.
                  </p>
                  <p>
                    Durante ogni giornata le partecipanti lavoreranno fianco a fianco con il Master ospite,
                    sviluppando tecniche avanzate, precisione e nuove visioni professionali.
                  </p>
                  <h4>Cosa include</h4>
                  <ul>
                    <li>6 giornate di formazione con Master internazionali e mondiali</li>
                    <li>Classi a numero chiuso (max 12 partecipanti)</li>
                    <li>6 attestati di partecipazione</li>
                    <li>Valutazione tecnica durante il percorso</li>
                    <li>Kit professionale in omaggio firmato CHRIS NAILS</li>
                    <li>Gadget e merchandising esclusivo</li>
                    <li>Full immersion tecnica con i Master</li>
                    <li>Confronto diretto con professionisti di fama mondiale</li>
                    <li>Esperienza formativa ad alta intensita tecnica</li>
                    <li>Cerimonia finale con consegna ufficiale degli attestati e Master Award Day</li>
                  </ul>
                  <h4>Certificazione finale</h4>
                  <p>
                    Al termine del percorso le partecipanti riceveranno una certificazione finale basata sulla
                    valutazione tecnica ottenuta durante il percorso.
                  </p>
                  <p>In base al livello raggiunto verra assegnato uno dei seguenti attestati:</p>
                  <ul>
                    <li>Master Experience (Gold)</li>
                    <li>Master Experience Expert (Platinum)</li>
                  </ul>
                  <p>
                    Una certificazione di alto valore che riconosce il livello tecnico raggiunto e l&apos;esperienza
                    formativa vissuta.
                  </p>
                </div>
              )}
            </article>
            <div class="grid three-col" style="margin-top: 10px;">
              {track.sessions.map((session) => (
                <article class={`card schedule-card ${session.isCeremony ? "ceremony-card" : ""}`}>
                  {!session.isCeremony && (
                    <img
                      src={session.image}
                      alt={`Master ${session.master}`}
                      loading="lazy"
                      decoding="async"
                      width="640"
                      height="760"
                      style={session.imagePosition ? `object-position: ${session.imagePosition};` : undefined}
                    />
                  )}
                  <div class="schedule-card-body">
                    <p class="eyebrow">{session.date}</p>
                    <h3>{session.master}</h3>
                    {session.isCeremony
                      ? pageContent.ceremonyCardParagraphs.map((paragraph) => <p>{paragraph}</p>)
                      : <p>{session.lessonPlaceholder}</p>}
                    {!session.isCeremony && (
                      <button
                        class="btn btn-secondary schedule-card-action"
                        type="button"
                        data-open-master-modal
                        data-track-name={track.name}
                        data-course-name={session.lessonPlaceholder}
                        data-master-name={session.master}
                        data-course-date={session.date}
                        data-start-time="9.00"
                        data-end-time="18:00"
                        data-modal-carousel-images={JSON.stringify(
                          session.modalCarouselImages ?? defaultModalCarouselImages,
                        )}
                      >
                        Scopri
                      </button>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section" id={sectionAnchors.requisiti}>
      <div class="container grid two-col">
        <article class="card content-card">
          <h2 class="section-title">Requisiti di partecipazione</h2>
          <p>{pageContent.requirementsIntro}</p>
          <p class="section-subtitle">Per partecipare è necessario aver completato almeno uno dei seguenti corsi:</p>
          <ul style="margin-top: 12px;">
            {pageContent.requirements.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <h3 style="margin-top: 12px;">{pageContent.requirementsEvaluationTitle}</h3>
          <p>{pageContent.requirementsEvaluation}</p>
          <h3>{pageContent.preMasterTitle}</h3>
          <p>{pageContent.preMaster}</p>
        </article>
        <article class="card content-card">
          <h2 class="section-title">Kit professionale incluso</h2>
          <p>
            Durante il percorso verranno utilizzati prodotti professionali della linea Chris Nails, insieme ad
            altri marchi selezionati messi a disposizione dai Master per lo svolgimento delle diverse
            tecniche.
          </p>
          <p>
            Ogni partecipante riceverà prodotti gratuiti da utilizzare durante le giornate formative, così da
            poter lavorare direttamente con materiali professionali durante le lezioni.
          </p>
          <p>
            Il percorso ti permetterà comunque di lavorare anche con i prodotti che utilizzi abitualmente,
            così da applicare le tecniche apprese con i materiali che preferisci.
          </p>
          <p>
            Prima dell&apos;inizio del percorso verrà inoltre inviata una lista dei materiali da portare, dove
            saranno indicati:
          </p>
          <ul style="margin-top: 12px;">
            <li>materiali necessari</li>
            <li>materiali opzionali</li>
          </ul>
          <p>
            In modo da permettere a ogni partecipante di organizzarsi al meglio.
          </p>
          <p>
            Durante il percorso verrà inoltre creato un gruppo WhatsApp dedicato, dove verrranno condivise
            tutte le comunicazioni organizzative, eventuali materiali di supporto e dispense didattiche
            quando previste.
          </p>
          <h3>Cosa portare ai corsi</h3>
          <p class="section-subtitle">
            Per partecipare sarà necessario portare solo la propria attrezzatura personale. Tutti gli altri
            prodotti verranno forniti durante i corsi.
          </p>
          <ul style="margin-top: 12px;">
            <li>Lampada UV / LED</li>
            <li>Fresa</li>
            <li>Punte per fresa</li>
            <li>Pennelli da lavoro</li>
            <li>Attrezzatura personale (forbicine, spingicuticole, ecc.)</li>
          </ul>
          <p style="margin-top: 14px;">
            Tutti gli altri prodotti necessari allo svolgimento delle lezioni verranno messi a disposizione
            durante il percorso.
          </p>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="marked-text" style="text-align: center;">Assicurati il tuo posto con una quota di iscrizione di €299.</p>
        <div class="grid two-col">
        <article class="card content-card">
          <h2 class="section-title">Cosa succede durante una giornata di master</h2>
          <p>
            Durante ogni giornata di formazione lavorerai direttamente con il Master seguendo tutte le fasi
            della tecnica proposta.
          </p>
          <ul>
            <li>Dimostrazione tecnica del Master passo dopo passo</li>
            <li>Fase pratica guidata con applicazione immediata</li>
            <li>Valutazione tecnica su struttura, precisione, pulizia ed equilibrio</li>
            <li>Focus su limatura e rifinitura professionale</li>
          </ul>
          <p>{pageContent.dayFlowOutro}</p>
        </article>
        <article class="card content-card">
          <h2 class="section-title">Perché partecipare ai Percorsi Master</h2>
          <p>{pageContent.whyParticipate}</p>
          <p><strong>{pageContent.urgency}</strong></p>
          <p class="marked-strong">{pageContent.closingStrong}</p>
        </article>
        </div>
      </div>
    </section>

    <section class="section" id={sectionAnchors.faq}>
      <div class="container">
        <h2 class="section-title">Domande frequenti</h2>
        <div class="card content-card" style="margin-top: 16px;">
          {pageContent.faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id={sectionAnchors.contatti}>
      <div class="container">
        <article class="card lead-wrap">
          <h2 class="section-title" style="margin-bottom: 10px;">{pageContent.leadForm.title}</h2>
          <p class="section-subtitle">{pageContent.leadForm.subtitle}</p>
          <p class="marked-strong">{pageContent.leadForm.limitedSeatsLine}</p>
          <p class="marked-text">Assicurati il tuo posto con una quota di iscrizione di €299.</p>

          <form class="lead-form" action="/api/lead" method="post" data-lead-form>
            <input name="nome" type="text" placeholder="Nome e cognome" required />
            <input name="email" type="email" placeholder="Email" required />
            <input name="telefono" type="tel" placeholder="Telefono" required />
            <textarea name="messaggio" placeholder="Dimmi quale percorso ti interessa" required></textarea>
            <label class="small-text">
              <input type="checkbox" name="privacy" required />
              {pageContent.leadForm.privacyText}
            </label>
            <button type="submit" class="btn btn-primary">{pageContent.leadForm.submitLabel}</button>
            <p class="form-status-message" data-form-status aria-live="polite"></p>
          </form>
        </article>
      </div>
    </section>

    <!-- <section class="section sponsors-section">
      <div class="container">
        <h2 class="section-title">I Nostri Sponsor</h2>
        <div class="sponsors-grid">
          {Array.from({ length: 5 }).map((_, index) => (
            <article class="card sponsor-card">
              <img
                src="/images/sponsor-1-no-bg.webp"
                alt={`Logo sponsor partner Beauty Line Academy ${index + 1}`}
                class="sponsor-logo"
                loading="lazy"
                decoding="async"
                width="280"
                height="120"
              />
            </article>
          ))}
        </div>
      </div>
    </section> -->
  </main>

  <div class="master-modal" data-master-modal hidden>
    <div class="master-modal-backdrop" data-close-master-modal></div>
    <div class="master-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="master-modal-title">
      <button type="button" class="master-modal-close" aria-label="Chiudi" data-close-master-modal>&times;</button>
      <div class="master-carousel">
        <button type="button" class="carousel-control" aria-label="Immagine precedente" data-carousel-prev>
          &#8249;
        </button>
        <img src="" alt="" class="master-carousel-image" data-carousel-image />
        <button type="button" class="carousel-control" aria-label="Immagine successiva" data-carousel-next>
          &#8250;
        </button>
      </div>
      <div class="master-modal-info">
        <p class="eyebrow" data-modal-track></p>
        <h3 id="master-modal-title" data-modal-title></h3>
        <p data-modal-description></p>
      </div>
    </div>
  </div>

  <SiteFooter />

  <script define:vars={{ defaultModalCarouselImages, heroCarouselImages, heroImageAlt: pageContent.hero.imageAlt }}>
    const navToggle = document.querySelector("[data-nav-toggle]");
    const headerNav = document.querySelector("[data-header-nav]");
    const leadForm = document.querySelector("[data-lead-form]");
    const statusMessage = document.querySelector("[data-form-status]");
    const masterModal = document.querySelector("[data-master-modal]");

    if (navToggle instanceof HTMLButtonElement && headerNav instanceof HTMLElement) {
      const closeMenu = () => {
        navToggle.setAttribute("aria-expanded", "false");
        headerNav.dataset.open = "false";
      };

      navToggle.addEventListener("click", () => {
        const isExpanded = navToggle.getAttribute("aria-expanded") === "true";
        navToggle.setAttribute("aria-expanded", String(!isExpanded));
        headerNav.dataset.open = String(!isExpanded);
      });

      headerNav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth > 900) {
          closeMenu();
        }
      });
    }

    if (leadForm instanceof HTMLFormElement && statusMessage instanceof HTMLParagraphElement) {
      leadForm.addEventListener("submit", async (event) => {
        event.preventDefault();

        const submitButton = leadForm.querySelector('button[type="submit"]');
        if (!(submitButton instanceof HTMLButtonElement)) return;

        statusMessage.textContent = "Invio in corso...";
        statusMessage.dataset.status = "pending";
        submitButton.disabled = true;

        try {
          const response = await fetch("/api/lead", {
            method: "POST",
            body: new FormData(leadForm),
          });

          const payload = await response.json().catch(() => ({ message: "" }));

          if (!response.ok) {
            throw new Error(payload.message || "Errore durante l'invio della richiesta.");
          }

          leadForm.reset();
          statusMessage.textContent = "Grazie! Ti contatteremo al piu presto.";
          statusMessage.dataset.status = "success";
        } catch (error) {
          const errorMessage =
            error instanceof Error ? error.message : "Impossibile inviare il modulo.";
          statusMessage.textContent = errorMessage;
          statusMessage.dataset.status = "error";
        } finally {
          submitButton.disabled = false;
        }
      });
    }

    if (masterModal instanceof HTMLElement) {
      const openButtons = document.querySelectorAll("[data-open-master-modal]");
      const closeButtons = masterModal.querySelectorAll("[data-close-master-modal]");
      const titleEl = masterModal.querySelector("[data-modal-title]");
      const descriptionEl = masterModal.querySelector("[data-modal-description]");
      const trackEl = masterModal.querySelector("[data-modal-track]");
      const carouselImageEl = masterModal.querySelector("[data-carousel-image]");
      const prevButton = masterModal.querySelector("[data-carousel-prev]");
      const nextButton = masterModal.querySelector("[data-carousel-next]");

      let carouselImages = [];
      let currentSlide = 0;

      const renderSlide = () => {
        if (!(carouselImageEl instanceof HTMLImageElement)) return;
        if (carouselImages.length === 0) return;

        carouselImageEl.src = carouselImages[currentSlide];
        const modalTitle = titleEl instanceof HTMLElement ? titleEl.textContent?.trim() : "";
        carouselImageEl.alt = modalTitle
          ? `${modalTitle} - immagine ${currentSlide + 1}`
          : `Galleria master - immagine ${currentSlide + 1}`;
      };

      const closeMasterModal = () => {
        masterModal.setAttribute("hidden", "");
        document.body.style.overflow = "";
      };

      const openMasterModal = (button) => {
        if (
          !(titleEl instanceof HTMLElement) ||
          !(descriptionEl instanceof HTMLParagraphElement) ||
          !(trackEl instanceof HTMLElement)
        ) {
          return;
        }

        const courseName = button.dataset.courseName || "Corso da definire";
        const masterName = button.dataset.masterName || "Master da definire";
        const courseDate = button.dataset.courseDate || "data da definire";
        const startTime = button.dataset.startTime || "9.00";
        const endTime = button.dataset.endTime || "18:00";
        const trackName = button.dataset.trackName || "";
        const carouselJson = button.dataset.modalCarouselImages || "[]";
        try {
          const parsed = JSON.parse(carouselJson);
          carouselImages = Array.isArray(parsed) ? parsed.filter((u) => typeof u === "string") : [];
        } catch {
          carouselImages = [];
        }
        if (carouselImages.length === 0) {
          carouselImages = [...defaultModalCarouselImages];
        }
        currentSlide = 0;
        renderSlide();

        titleEl.textContent = `${courseName} - ${masterName}`;
        trackEl.textContent = trackName;
        descriptionEl.textContent = `Il corso ${courseName} del Master ${masterName} si terrà il giorno ${courseDate} dalle ore ${startTime} alle ${endTime}.`;
        masterModal.removeAttribute("hidden");
        document.body.style.overflow = "hidden";
      };

      openButtons.forEach((button) => {
        if (!(button instanceof HTMLElement)) return;

        button.addEventListener("click", () => {
          openMasterModal(button);
        });
      });

      closeButtons.forEach((button) => {
        if (!(button instanceof HTMLElement)) return;
        button.addEventListener("click", closeMasterModal);
      });

      if (prevButton instanceof HTMLButtonElement) {
        prevButton.addEventListener("click", () => {
          if (carouselImages.length === 0) return;
          currentSlide = (currentSlide - 1 + carouselImages.length) % carouselImages.length;
          renderSlide();
        });
      }

      if (nextButton instanceof HTMLButtonElement) {
        nextButton.addEventListener("click", () => {
          if (carouselImages.length === 0) return;
          currentSlide = (currentSlide + 1) % carouselImages.length;
          renderSlide();
        });
      }

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !masterModal.hasAttribute("hidden")) {
          closeMasterModal();
        }
      });
    }

    const heroRoot = document.querySelector("[data-hero-carousel]");
    if (heroRoot instanceof HTMLElement) {
      const heroImg = heroRoot.querySelector("[data-hero-carousel-img]");
      const heroPrev = heroRoot.querySelector("[data-hero-carousel-prev]");
      const heroNext = heroRoot.querySelector("[data-hero-carousel-next]");
      const heroDots = heroRoot.querySelectorAll("[data-hero-carousel-dot]");
      let heroIdx = 0;
      const heroSlides = heroCarouselImages;
      const heroTotal = heroSlides.length;

      const renderHero = () => {
        if (!(heroImg instanceof HTMLImageElement)) return;
        heroImg.src = heroSlides[heroIdx];
        heroImg.alt = `${heroImageAlt} - immagine ${heroIdx + 1} di ${heroTotal}`;
        heroDots.forEach((dot, j) => {
          if (!(dot instanceof HTMLButtonElement)) return;
          const on = j === heroIdx;
          dot.classList.toggle("is-active", on);
          dot.setAttribute("aria-current", on ? "true" : "false");
        });
      };

      const heroGo = (delta) => {
        heroIdx = (heroIdx + delta + heroTotal) % heroTotal;
        renderHero();
      };

      if (heroPrev instanceof HTMLButtonElement) {
        heroPrev.addEventListener("click", () => heroGo(-1));
      }
      if (heroNext instanceof HTMLButtonElement) {
        heroNext.addEventListener("click", () => heroGo(1));
      }
      heroDots.forEach((dot, j) => {
        dot.addEventListener("click", () => {
          heroIdx = j;
          renderHero();
        });
      });

      let heroTimer = null;
      let heroHover = false;
      const heroStartAutoplay = () => {
        if (heroTimer || heroTotal <= 1 || heroHover || document.hidden) return;
        heroTimer = window.setInterval(() => heroGo(1), 6000);
      };
      const heroStopAutoplay = () => {
        if (heroTimer) {
          clearInterval(heroTimer);
          heroTimer = null;
        }
      };

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        heroRoot.addEventListener("mouseenter", () => {
          heroHover = true;
          heroStopAutoplay();
        });
        heroRoot.addEventListener("mouseleave", () => {
          heroHover = false;
          heroStartAutoplay();
        });
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            heroStopAutoplay();
          } else {
            heroStartAutoplay();
          }
        });
        heroStartAutoplay();
      }

      renderHero();
    }
  </script>

</BaseLayout>
