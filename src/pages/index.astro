---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageContent, percorsi, programTracks, sectionAnchors } from "../data/percorsi";
---

<BaseLayout title="Percorsi Master | Beauty Line Academy" description={pageContent.hero.description}>
  <header class="site-header">
    <div class="container header-inner">
      <strong>{pageContent.brand}</strong>
      <nav class="header-nav">
        <a href={`#${sectionAnchors.percorsi}`}>Percorsi</a>
        <a href={`#${sectionAnchors.programma}`}>Programma</a>
        <a href={`#${sectionAnchors.requisiti}`}>Requisiti</a>
        <a href={`#${sectionAnchors.faq}`}>FAQ</a>
        <a href={`#${sectionAnchors.contatti}`}>Contatti</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div>
          <p class="eyebrow">{pageContent.hero.eyebrow}</p>
          <h1>{pageContent.hero.title}</h1>
          <p class="marked-text">{pageContent.hero.depositLine}</p>
          <p>{pageContent.hero.description}</p>
          <p class="marked-strong">{pageContent.hero.limitedSeats}</p>
          <div class="btn-row">
            <a class="btn btn-primary" href={`#${sectionAnchors.contatti}`}>{pageContent.hero.ctaPrimary}</a>
            <a class="btn btn-secondary" href={`#${sectionAnchors.programma}`}>{pageContent.hero.ctaSecondary}</a>
          </div>
        </div>
        <div class="placeholder-media" role="img" aria-label={pageContent.hero.imageAlt}>
          {pageContent.hero.imagePlaceholder}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <article class="card content-card">
          {pageContent.hero.introParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <p class="strong-black-line">{pageContent.hero.strongLine}</p>
          <p class="marked-text">{pageContent.hero.depositLine}</p>
        </article>
      </div>
    </section>

    <section class="section" id={sectionAnchors.percorsi}>
      <div class="container">
        <h2 class="section-title">{pageContent.comparisonTitle}</h2>
        <p class="section-subtitle">{pageContent.comparisonIntro}</p>
        <div class="grid two-col percorso-cards-grid" style="margin-top: 24px;">
          {percorsi.map((percorso) => (
            <article class="card content-card">
              <p class="percorso-name">{percorso.shortName}</p>
              <h4>Date percorso</h4>
              <ul class="date-master-list">
                {programTracks
                  .find((track) => track.name === percorso.name)
                  ?.sessions.map((session) => (
                    <li class="date-master-line">
                      <span class="date-master-date">{session.date}</span>
                      <span class="date-master-separator">-</span>
                      <span class="date-master-name">{session.master}</span>
                    </li>
                  ))}
              </ul>
            </article>
          ))}
        </div>
        <article class="card content-card shared-info-card" style="margin-top: 20px;">
          <h3>{pageContent.sharedInfoTitle}</h3>
          <div class="shared-feature-top-cards" style="margin-top: 14px;">
            {pageContent.sharedFeatures.slice(0, 3).map((feature) => {
              const match = feature.match(/^(\d+)\s+(.+)$/);
              const amount = match?.[1] ?? "";
              const label = match?.[2] ?? feature;

              return (
                <article class="shared-number-card">
                  {amount && <span class="shared-number-value">{amount}</span>}
                  <span class="shared-number-label">{label}</span>
                </article>
              );
            })}
          </div>
          <ul class="shared-feature-list">
            {pageContent.sharedFeatures.slice(3).map((feature) => {
              if (feature.startsWith("Kit professionale")) {
                return (
                  <li>
                    + <strong>Kit professionale</strong>
                    {feature.replace("Kit professionale", "")}
                  </li>
                );
              }

              if (feature.startsWith("Gadget e merchandising")) {
                return (
                  <li>
                    + <strong>Gadget e merchandising</strong>
                    {feature.replace("Gadget e merchandising", "")}
                  </li>
                );
              }

              return <li>+ {feature}</li>;
            })}
          </ul>
          <p class="shared-strong-line">
            + <strong>Attestato</strong> {pageContent.sharedInfoStrong.replace(/^Attestato\s*/i, "")}
          </p>
          <p class="shared-ceremony">
            {pageContent.openingCeremonyLabel}: {pageContent.openingCeremonyDate}
          </p>
        </article>
      </div>
    </section>

    <section class="section" id={sectionAnchors.programma}>
      <div class="container">
        <h2 class="section-title">{pageContent.programSectionTitle}</h2>
        <p class="marked-text">{pageContent.hero.depositLine}</p>
        <p class="section-subtitle">{pageContent.programIntro}</p>
        {pageContent.programDetails.map((line) => (
          <p>{line}</p>
        ))}
        {programTracks.map((track) => (
          <div style="margin-top: 26px;">
            <p class="percorso-name percorso-name-program" style="margin-bottom: 0;">{track.name}</p>
            <p class="marked-text" style="text-align: center;">{track.description}</p>
            <p class="marked-text" style="text-align: center;">{track.description2}</p>
            {track.name === "Percorso Master Pro" && (
              <div style="margin-top: 16px;">
                <p><strong>Crescita tecnica completa.</strong></p>
                <p>
                  Percorso pensato per onicotecniche che desiderano vivere la loro prima esperienza
                  all&apos;interno di un vero percorso Master.
                </p>
                <p>
                  E&apos; aperto a tutte le professioniste che vogliono migliorare la propria tecnica, confrontarsi con
                  Master nazionali e internazionali e iniziare a entrare nel mondo della formazione di alto livello.
                </p>
                <p>
                  Durante il percorso le partecipanti lavoreranno passo dopo passo insieme ai Master,
                  sviluppando precisione, struttura e metodo di lavoro professionale.
                </p>
                <h4>Cosa include</h4>
                <ul>
                  <li>6 giornate di formazione con Master nazionali e internazionali</li>
                  <li>Classi a numero chiuso (max 12 partecipanti)</li>
                  <li>6 attestati di partecipazione</li>
                  <li>Valutazione tecnica durante il percorso</li>
                  <li>Kit professionale in omaggio firmato CHRIS NAILS</li>
                  <li>Gadget e merchandising esclusivo</li>
                  <li>Confronto diretto con i Master durante le giornate di formazione</li>
                  <li>Preparazione tecnica per migliorare struttura, precisione e metodo di lavoro</li>
                  <li>Cerimonia finale con consegna ufficiale degli attestati - Master Award Day</li>
                </ul>
                <h4>Certificazione finale</h4>
                <p>
                  Al termine del percorso le partecipanti riceveranno una certificazione finale basata sulla
                  valutazione tecnica ottenuta durante il percorso.
                </p>
                <p>In base al livello raggiunto verra assegnato uno dei seguenti attestati:</p>
                <ul>
                  <li>Tecnico</li>
                  <li>Tecnico Expert</li>
                  <li>Master Gold</li>
                </ul>
                <p>
                  Un riconoscimento professionale che valorizza il percorso svolto e il livello tecnico raggiunto.
                </p>
              </div>
            )}
            {track.name === "Percorso Master Experience" && (
              <div style="margin-top: 16px;">
                <p><strong>Formazione intensiva con Master internazionali e mondiali</strong></p>
                <p>
                  Percorso dedicato a onicotecniche che hanno gia partecipato a campus, percorsi formativi, gare
                  o corsi avanzati e desiderano confrontarsi con Master internazionali e mondiali di altissimo
                  livello.
                </p>
                <p>
                  E&apos; pensato per professioniste che vogliono vivere una vera esperienza Master, lavorando
                  direttamente con grandi nomi del settore e portando la propria tecnica ad uno standard
                  superiore.
                </p>
                <p>
                  Durante ogni giornata le partecipanti lavoreranno fianco a fianco con il Master ospite,
                  sviluppando tecniche avanzate, precisione e nuove visioni professionali.
                </p>
                <h4>Cosa include</h4>
                <ul>
                  <li>6 giornate di formazione con Master internazionali e mondiali</li>
                  <li>Classi a numero chiuso (max 12 partecipanti)</li>
                  <li>6 attestati di partecipazione</li>
                  <li>Valutazione tecnica durante il percorso</li>
                  <li>Kit professionale in omaggio firmato CHRIS NAILS</li>
                  <li>Gadget e merchandising esclusivo</li>
                  <li>Full immersion tecnica con i Master</li>
                  <li>Confronto diretto con professionisti di fama mondiale</li>
                  <li>Esperienza formativa ad alta intensita tecnica</li>
                  <li>Cerimonia finale con consegna ufficiale degli attestati e Master Award Day</li>
                </ul>
                <h4>Certificazione finale</h4>
                <p>
                  Al termine del percorso le partecipanti riceveranno una certificazione finale basata sulla
                  valutazione tecnica ottenuta durante il percorso.
                </p>
                <p>In base al livello raggiunto verra assegnato uno dei seguenti attestati:</p>
                <ul>
                  <li>Master Experience Gold</li>
                  <li>Master Experience Platinum</li>
                </ul>
                <p>
                  Una certificazione di alto valore che riconosce il livello tecnico raggiunto e l&apos;esperienza
                  formativa vissuta.
                </p>
              </div>
            )}
            <div class="grid three-col" style="margin-top: 10px;">
              {track.sessions.map((session) => (
                <article class={`card schedule-card ${session.isCeremony ? "ceremony-card" : ""}`}>
                  {!session.isCeremony && (
                    <img
                      src={session.image}
                      alt={`Master ${session.master}`}
                      loading="lazy"
                      style={session.imagePosition ? `object-position: ${session.imagePosition};` : undefined}
                    />
                  )}
                  <div class="schedule-card-body">
                    <p class="eyebrow">{session.date}</p>
                    <h3>{session.master}</h3>
                    {session.isCeremony
                      ? pageContent.ceremonyCardParagraphs.map((paragraph) => <p>{paragraph}</p>)
                      : <p>{session.lessonPlaceholder}</p>}
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    {percorsi.map((percorso) => (
      <section class="section">
        <div class="container">
          <p class="marked-text" style="text-align: center; margin-bottom: 20px;">Solo 12 posti disponibili per ogni percorso master</p>
          <div class="grid two-col">
            <article class="card content-card">
              <p class="percorso-name">{percorso.name}</p>
              <h2 class="section-title" style="font-size: clamp(1.4rem, 2.1vw, 2rem);">{percorso.subtitle}</h2>
              <p>{percorso.description}</p>
              <h4>Cosa include</h4>
              <ul>
                {percorso.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </article>
            <article class="card content-card">
              <h3>Certificazione finale</h3>
              <p class="section-subtitle">Durante il percorso ogni partecipante verrà valutata dai Master.</p>
              <p class="section-subtitle">Il punteggio finale determinerà il livello della certificazione ottenuta.</p>
              <ul style="margin-top: 12px;">
                {percorso.certifications.map((certification) => (
                  <li>
                    <span
                      class={`certification-level certification-${certification.level
                        .toLowerCase()
                        .replace(/\s+/g, "-")}`}
                    >
                      {certification.level}
                    </span>
                    {certification.label ? ` - ${certification.label}` : ""}
                  </li>
                ))}
              </ul>
              <div class="placeholder-media" style="margin-top: 18px; min-height: 160px;">
                Placeholder foto master / lavori corso
              </div>
            </article>
          </div>
        </div>
      </section>
    ))}

    <section class="section" id={sectionAnchors.requisiti}>
      <div class="container grid two-col">
        <article class="card content-card">
          <h2 class="section-title">Requisiti di partecipazione</h2>
          <p>{pageContent.requirementsIntro}</p>
          <p class="section-subtitle">Per partecipare è necessario aver completato almeno uno dei seguenti corsi:</p>
          <ul style="margin-top: 12px;">
            {pageContent.requirements.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <h3 style="margin-top: 12px;">{pageContent.requirementsEvaluationTitle}</h3>
          <p>{pageContent.requirementsEvaluation}</p>
          <h3>{pageContent.preMasterTitle}</h3>
          <p>{pageContent.preMaster}</p>
        </article>
        <article class="card content-card">
          <h2 class="section-title">Kit professionale incluso</h2>
          <p>
            Durante il percorso verranno utilizzati prodotti professionali della linea Chris Nails, insieme ad
            altri marchi selezionati messi a disposizione dai Master per lo svolgimento delle diverse
            tecniche.
          </p>
          <p>
            Ogni partecipante ricevera prodotti gratuiti da utilizzare durante le giornate formative, cosi da
            poter lavorare direttamente con materiali professionali durante le lezioni.
          </p>
          <p>
            Il percorso ti permettera comunque di lavorare anche con i prodotti che utilizzi abitualmente,
            cosi da applicare le tecniche apprese con i materiali che preferisci.
          </p>
          <p>
            Prima dell&apos;inizio del percorso verra inoltre inviata una lista dei materiali da portare, dove
            saranno indicati:
          </p>
          <ul style="margin-top: 12px;">
            <li>materiali necessari</li>
            <li>materiali opzionali</li>
          </ul>
          <p>
            in modo da permettere a ogni partecipante di organizzarsi al meglio.
          </p>
          <p>
            Durante il percorso verra inoltre creato un gruppo WhatsApp dedicato, dove verranno condivise
            tutte le comunicazioni organizzative, eventuali materiali di supporto e dispense didattiche
            quando previste.
          </p>
          <h3>Cosa portare ai corsi</h3>
          <p class="section-subtitle">
            Per partecipare sara necessario portare solo la propria attrezzatura personale. Tutti gli altri
            prodotti verranno forniti durante i corsi.
          </p>
          <ul style="margin-top: 12px;">
            <li>Lampada UV / LED</li>
            <li>Fresa</li>
            <li>Punte per fresa</li>
            <li>Pennelli da lavoro</li>
            <li>Attrezzatura personale (forbicine, spingicuticole, ecc.)</li>
          </ul>
          <p style="margin-top: 14px;">
            Tutti gli altri prodotti necessari allo svolgimento delle lezioni verranno messi a disposizione
            durante il percorso.
          </p>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="marked-text" style="text-align: center;">Assicurati il tuo posto con una quota di iscrizione di €299.</p>
        <div class="grid two-col">
        <article class="card content-card">
          <h2 class="section-title">Cosa succede durante una giornata di master</h2>
          <p>
            Durante ogni giornata di formazione lavorerai direttamente con il Master seguendo tutte le fasi
            della tecnica proposta.
          </p>
          <ul>
            <li>Dimostrazione tecnica del Master passo dopo passo</li>
            <li>Fase pratica guidata con applicazione immediata</li>
            <li>Valutazione tecnica su struttura, precisione, pulizia ed equilibrio</li>
            <li>Focus su limatura e rifinitura professionale</li>
          </ul>
          <p>{pageContent.dayFlowOutro}</p>
        </article>
        <article class="card content-card">
          <h2 class="section-title">Perché partecipare ai Percorsi Master</h2>
          <p>{pageContent.whyParticipate}</p>
          <p><strong>{pageContent.urgency}</strong></p>
          <p class="marked-strong">{pageContent.closingStrong}</p>
        </article>
        </div>
      </div>
    </section>

    <section class="section" id={sectionAnchors.faq}>
      <div class="container">
        <h2 class="section-title">Domande frequenti</h2>
        <div class="card content-card" style="margin-top: 16px;">
          {pageContent.faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id={sectionAnchors.contatti}>
      <div class="container">
        <article class="card lead-wrap">
          <h2 class="section-title" style="margin-bottom: 10px;">{pageContent.leadForm.title}</h2>
          <p class="section-subtitle">{pageContent.leadForm.subtitle}</p>
          <p class="marked-strong">{pageContent.leadForm.limitedSeatsLine}</p>
          <p class="marked-text">Assicurati il tuo posto con una quota di iscrizione di €299.</p>

          <form class="lead-form" action="#" method="post">
            <input name="nome" type="text" placeholder="Nome e cognome" />
            <input name="email" type="email" placeholder="Email" />
            <input name="telefono" type="tel" placeholder="Telefono" />
            <textarea name="messaggio" placeholder="Dimmi quale percorso ti interessa"></textarea>
            <label class="small-text">
              <input type="checkbox" name="privacy" />
              {pageContent.leadForm.privacyText}
            </label>
            <button type="submit" class="btn btn-primary">{pageContent.leadForm.submitLabel}</button>
          </form>
        </article>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p><strong>{pageContent.brand}</strong></p>
      <p>{pageContent.contactAddress}</p>
      <p>Info e iscrizioni: {pageContent.contactPhone}</p>
      <p>
        Sito ufficiale: <a href={pageContent.siteUrl} target="_blank" rel="noreferrer">{pageContent.siteUrl}</a>
      </p>
    </div>
  </footer>

</BaseLayout>
